  "flow": {
    "triggers": [
      {
        "title": {
          "en": "The irrigation health status changes",
          "es": "Cambia el estado de salud del riego"
        },
        "hint": {
          "en": "Use this trigger to notify hardware, ESPHome or engine health incidents detected by the native app.",
          "es": "Usa este disparador para avisar incidencias de hardware, ESPHome o motor detectadas por la app nativa."
        },
        "tokens": [
          {
            "name": "status",
            "type": "string",
            "title": {
              "en": "Status",
              "es": "Estado"
            },
            "example": "OFFLINE"
          },
          {
            "name": "message",
            "type": "string",
            "title": {
              "en": "Message",
              "es": "Mensaje"
            },
            "example": "OFFLINE - Controlador ESP32 desconectado"
          },
          {
            "name": "issueCodes",
            "type": "string",
            "title": {
              "en": "Issue codes",
              "es": "Codigos de incidencia"
            },
            "example": "ESP_OFFLINE,ENGINE_CONTROLLER_OFFLINE"
          }
        ],
        "id": "health_transition"
      },
      {
        "title": {
          "en": "The scheduler requests an irrigation program",
          "es": "El programador solicita un programa de riego"
        },
        "hint": {
          "en": "Pass the Request token to Irrigation.js using the HomeyScript card with an argument.",
          "es": "Entrega la etiqueta Solicitud a Irrigation.js mediante la tarjeta HomeyScript con argumento."
        },
        "tokens": [
          {
            "name": "request",
            "type": "string",
            "title": {
              "en": "Request",
              "es": "Solicitud"
            },
            "example": "{\"version\":1,\"requestId\":\"...\",\"queue\":[{\"sector\":1,\"duration\":10}]}"
          }
        ],
        "id": "program_requested"
      },
      {
        "id": "recovery_event",
        "title": {
          "en": "An ESPHome Controller recovery event occurs",
          "es": "Ocurre un evento de recuperacion de ESPHome Controller"
        },
        "hint": {
          "en": "Use this trigger to notify automatic ESPHome Controller recovery attempts handled by the native app.",
          "es": "Usa este disparador para avisar intentos de recuperacion automatica de ESPHome Controller gestionados por la app nativa."
        },
        "tokens": [
          {
            "name": "status",
            "type": "string",
            "title": {
              "en": "Status",
              "es": "Estado"
            },
            "example": "RESTART_REQUESTED"
          },
          {
            "name": "message",
            "type": "string",
            "title": {
              "en": "Message",
              "es": "Mensaje"
            },
            "example": "Reinicio automatico 1/3 de ESPHome Controller solicitado"
          },
          {
            "name": "attempts",
            "type": "number",
            "title": {
              "en": "Attempts",
              "es": "Intentos"
            },
            "example": 1
          }
        ]
      },
      {
        "title": {
          "en": "An irrigation sector ends",
          "es": "Termina un sector de riego"
        },
        "hint": {
          "en": "Use this trigger to notify sector endings emitted by the native Rama 2 engine.",
          "es": "Usa este disparador para avisar finales de sector emitidos por el motor nativo de Rama 2."
        },
        "tokens": [
          {
            "name": "message",
            "type": "string",
            "title": {
              "en": "Message",
              "es": "Mensaje"
            },
            "example": "Finalizado sector 1: 12.5 L"
          },
          {
            "name": "sector",
            "type": "number",
            "title": {
              "en": "Sector",
              "es": "Sector"
            },
            "example": 1
          },
          {
            "name": "duration",
            "type": "number",
            "title": {
              "en": "Duration",
              "es": "Duracion"
            },
            "example": 5
          },
          {
            "name": "liters",
            "type": "number",
            "title": {
              "en": "Liters",
              "es": "Litros"
            },
            "example": 12.5
          },
          {
            "name": "reason",
            "type": "string",
            "title": {
              "en": "Reason",
              "es": "Motivo"
            },
            "example": "timeout"
          },
          {
            "name": "source",
            "type": "string",
            "title": {
              "en": "Source",
              "es": "Origen"
            },
            "example": "MANUAL"
          }
        ],
        "id": "sector_ended"
      },
      {
        "title": {
          "en": "An irrigation sector starts",
          "es": "Empieza un sector de riego"
        },
        "hint": {
          "en": "Use this trigger to notify sector starts emitted by the native Rama 2 engine.",
          "es": "Usa este disparador para avisar inicios de sector emitidos por el motor nativo de Rama 2."
        },
        "tokens": [
          {
            "name": "message",
            "type": "string",
            "title": {
              "en": "Message",
              "es": "Mensaje"
            },
            "example": "Iniciado sector 1: 5 min (MANUAL)"
          },
          {
            "name": "sector",
            "type": "number",
            "title": {
              "en": "Sector",
              "es": "Sector"
            },
            "example": 1
          },
          {
            "name": "duration",
            "type": "number",
            "title": {
              "en": "Duration",
              "es": "Duracion"
            },
            "example": 5
          },
          {
            "name": "source",
            "type": "string",
            "title": {
              "en": "Source",
              "es": "Origen"
            },
            "example": "MANUAL"
          }
        ],
        "id": "sector_started"
      }
    ],
    "conditions": [
